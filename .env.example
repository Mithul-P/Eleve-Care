# Copy to .env and fill in. Never commit .env.

# --- database ---
# docker compose overrides this with mongodb://mongo:27017
MONGO_URL=mongodb://localhost:27017
MONGO_DB=elevcare
# MONGO_URL=mongomock://          # in-memory, no MongoDB needed (dev only; data lost on restart)

# --- auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
SEED_ADMIN_EMAIL=admin@elevcare.local
SEED_ADMIN_PASSWORD=
SEED_STAFF_EMAIL=staff@elevcare.local
SEED_STAFF_PASSWORD=
# If a password is empty, a random one is generated and printed once in the backend log.

# --- seeding ---
SEED_ON_STARTUP=true
SEED_HISTORY_DAYS=60

# --- simulator ---
SIM_ENABLED=true
SIM_MODE=batch                        # batch | real-time
SIM_BATCH_HOURS=6                     # simulated hours per batch chunk
SIM_BATCH_INTERVAL_SECONDS=21600      # wall-clock seconds between chunks (6 h); lower for demos
SIM_REALTIME_INTERVAL_SECONDS=3
SIM_REALTIME_ACCELERATION=1           # >1 compresses time in real-time mode
SIM_REALTIME_WAVEFORM_EVERY=5         # store the full waveform on every Nth real-time reading

# --- external sensor ingestion (POST /ingest/readings with header X-Ingest-Key) ---
INGEST_API_KEY=

# --- AI chatbot (optional) ---
# Without a key the assistant answers with its built-in rule engine.
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-sonnet-4-6   # any current Claude model id; a failed call falls back to the rule engine
CHATBOT_MAX_TOKENS=1200

# --- economics ---
ENERGY_TARIFF_INR_PER_KWH=5
GRID_EMISSION_KG_PER_KWH=0.71

# --- HTTP ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
COMPLAINT_RATE_LIMIT_PER_MINUTE=5
